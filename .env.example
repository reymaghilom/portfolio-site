# Contact form (app/api/contact/route.ts) — sends messages through Resend.
# Copy this file to .env.local for development, and set the same variables on your host.
# Messages are delivered to `contactEmail` in data/portfolio.ts.

# Server-side only: create one at https://resend.com/api-keys. Never prefix it with NEXT_PUBLIC_.
RESEND_API_KEY=

# The sender: display name and address. Quote the name if it contains a period (e.g.
# "C."), and wrap the whole value in single quotes so those quotes are kept. Use an
# address on a domain you've verified in Resend, e.g.
#   CONTACT_FROM_EMAIL='"Rey C. Maghilom — Portfolio" <contact@yourdomain.com>'
# Before a domain is verified, Resend's test sender works, but it only delivers to the
# email address of your Resend account:
#   CONTACT_FROM_EMAIL='"Rey C. Maghilom — Portfolio" <onboarding@resend.dev>'
CONTACT_FROM_EMAIL=

# AI portfolio assistant (app/api/chat/route.ts) — Google Gemini.
# Server-side only: create one at https://aistudio.google.com/apikey. Never prefix it
# with NEXT_PUBLIC_. The model is set in lib/chat-config.ts (GEMINI_MODEL).
GEMINI_API_KEY=
